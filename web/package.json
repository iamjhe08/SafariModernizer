{
  "name": "safarimodernizer-web",
  "version": "1.0.0",
  "private": true,
  "description": "Page-side scripts of SafariModernizer: polyfills, CSS rewriter, module loader and fixes for Safari 15.",
  "license": "MIT",
  "author": "T4MAG0",
  "scripts": {
    "build": "node build.mjs && esbuild main.js --bundle --platform=browser --format=iife --target=safari15 --minify --legal-comments=none --outfile=smfix.min.js",
    "test": "node ../tests/run-all.cjs"
  },
  "dependencies": {
    "@csstools/postcss-color-mix-function": "^4.0.14",
    "@csstools/postcss-light-dark-function": "^3.0.6",
    "@csstools/postcss-oklab-function": "^5.0.14",
    "@oddbird/popover-polyfill": "^0.7.3",
    "acorn": "^8.18.0",
    "construct-style-sheets-polyfill": "^3.1.0",
    "core-js-builder": "^3.50.0",
    "css-has-pseudo": "^8.0.1",
    "element-internals-polyfill": "^3.0.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "focus-visible": "^5.2.1",
    "invokers-polyfill": "^1.0.4",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-focus-visible": "^11.0.0",
    "postcss-nesting": "^14.0.2",
    "terser": "^5.51.2",
    "wicg-inert": "^3.1.3"
  }
